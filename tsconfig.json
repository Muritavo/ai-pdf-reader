{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@onepercentio/one-ui/components/ScrollendIndicator": ["./node_modules/@onepercentio/one-ui/dist-ts/components/ScrollendIndicator/ScrollendIndicator"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/context/Repository.tsx"]
}
